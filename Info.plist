<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opt out of the macOS 26 redesign: keeps the tighter window corner
	     radius and plain toolbar items instead of glass capsules. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<!-- Friends' sites aren't all on https. Without this, App Transport
	     Security silently blocks every http:// page, favicon and title. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
